# Postgres. Locally: `docker compose up -d db` (from the repo root) gives this one.
DATABASE_URL=postgresql://kr:kr@localhost:5433/khanan
GOOGLE_CLIENT_ID=...                        # same Google client ID as the web app
ADMIN_EMAILS=you@gmail.com,other@gmail.com  # these accounts become admin on sign-in
JWT_SECRET=any-long-random-string           # signs login tokens; required in production
ATTENDANCE_RADIUS_OVERRIDE_M=               # optional, testing only: e.g. 10000 lets you check in from 10 km away
GROQ_API_KEY=                               # optional: enables Governance intelligence narratives
GROQ_MODEL=openai/gpt-oss-120b
